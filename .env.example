# ==============================================================================
# Excel Legacy Realty CRM - Environment Configuration
# ==============================================================================

# --- DATABASE ---
# In development, you can use SQLite. For production, supply a Postgres connection string.
DATABASE_URL="postgresql://postgres:password@localhost:5432/realestatecrm"

# --- NEXTAUTH ---
# Must be the canonical base URL of your application in production (e.g. https://crm.excellegacy.com)
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret via: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# --- EMAIL / MAGIC LINKS ---
# SMTP server for NextAuth magic links
EMAIL_SERVER=smtp://username:password@smtp.example.com:587
EMAIL_FROM=noreply@excellegacy.com

# --- AI & RAG PIPELINE ---
OPENAI_API_KEY="sk-..."
RAG_EMBEDDING_MODEL="text-embedding-3-small"
RAG_VECTOR_PROVIDER="pinecone"

# Pinecone Hosted Vector Settings
PINECONE_API_KEY="pcsk_..."
PINECONE_INDEX_HOST="https://your-index-host.svc.us-east1-gcp.pinecone.io"
PINECONE_NAMESPACE="excel-legacy-workspace"

# Alternate Vector Sync Settings
RAG_VECTOR_ENDPOINT="https://your-custom-vector-service.example.com/upsert"
RAG_VECTOR_API_KEY="replace-with-vector-sync-key"

# --- MLS INTEGRATION ---
MIREALSOURCE_USERNAME=your_username
MIREALSOURCE_PASSWORD=your_password

# --- INITIAL SETUP / SEEDING (DEV ONLY) ---
# Used exclusively by prisma/seed.mjs to bypass setup in local dev
SEED_ADMIN_EMAIL="admin@excellegacy.com"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="super-secret-local-password"
SEED_ADMIN_NAME="Excel Legacy Admin"

# Used specifically to allow a bypass auth route for testing
AUTH_DEMO_EMAIL="lum@example.com"
AUTH_DEMO_PASSWORD="demo-password"
AUTH_DEMO_NAME="Demo Admin"

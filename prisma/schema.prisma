generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  role          String            @default("AGENT")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  activities    Activity[]
  contacts      Contact[]
  deals         Deal[]
  leads         Lead[]
  assignedTasks Task[]            @relation("TaskAssignee")
  workflows     WorkflowSession[]
  workspaces    WorkspaceMember[]
  stakeholderIn DealStakeholder[]
}

model Workspace {
  id             String            @id @default(cuid())
  name           String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  Activity       Activity[]
  contacts       Contact[]
  deals          Deal[]
  leads          Lead[]
  smartPlans     SmartPlan[]
  workflows      WorkflowSession[]
  members        WorkspaceMember[]
  segments       Segment[]
  agentWorkflows AgentWorkflow[]
  agentLogs      AgentLog[]
  landingPages   LandingPage[]
  propertyListings       PropertyListing[]
  myPlusLeadsIntegrations MyPlusLeadsIntegration[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("AGENT")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Contact {
  id               String     @id @default(cuid())
  firstName        String
  lastName         String?
  email            String?
  phone            String?
  address          String?
  workspaceId      String
  userId           String?
  additionalPhones String?   // JSON array of additional phones
  additionalEmails String?   // JSON array of additional emails
  spouseName       String?
  spousePhone      String?
  spouseEmail      String?
  familyMembers    String?   // JSON array of family members
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  Activity         Activity[]
  user             User?      @relation(fields: [userId], references: [id])
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals            Deal[]
  leads            Lead[]
  stakeholderIn    DealStakeholder[]
}

model Lead {
  id              String            @id @default(cuid())
  type            String            @default("BUYER") // BUYER, SELLER, CLOSED
  source          String?
  status          String            @default("NEW") // Expanded statuses handled in UI logic
  score           Int?              @default(0)
  workspaceId     String
  contactId       String
  userId          String?
  isAiAssisted    Boolean           @default(false)
  socialProfiles  String?
  publicRecords   String?
  lastEnrichedAt  DateTime?
  tags            String?           // Comma-separated hashtags
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  smartPlanId     String?
  Activity        Activity[]
  smartPlan       SmartPlan?        @relation(fields: [smartPlanId], references: [id])
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact         Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id])
  WorkflowSession WorkflowSession[]
  tasks           Task[]
  searchAlerts    SearchAlert[]
  segments        Segment[]         @relation("LeadSegments")
  agentLogs       AgentLog[]
}

model SmartPlan {
  id          String    @id @default(cuid())
  name        String
  description String?
  steps       String?   // JSON string of steps
  isActive    Boolean   @default(true)
  scope       String    @default("INDIVIDUAL") // COMPANY or INDIVIDUAL
  leadType    String    @default("Buyer")
  duration    Int       @default(0)
  autoApply   Boolean   @default(false)
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  leads       Lead[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Deal {
  id              String            @id @default(cuid())
  title           String
  value           Float?
  stage           String            @default("LEAD")
  workspaceId     String
  contactId       String
  userId          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  Activity        Activity[]
  user            User?             @relation(fields: [userId], references: [id])
  contact         Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  WorkflowSession WorkflowSession[]
  tasks           Task[]
  stakeholders    DealStakeholder[]
  requirements    DealRequirement[]
}

model DealStakeholder {
  id          String    @id @default(cuid())
  dealId      String
  contactId   String?
  userId      String?
  role        String    // TITLE, LENDER, INSPECTOR, APPRAISER, CLIENT
  permissions String    @default("VIEW_STATUS") // UPLOAD_DOCS, VIEW_STATUS, FULL_ACCESS
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])
  contact     Contact?  @relation(fields: [contactId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DealRequirement {
  id          String    @id @default(cuid())
  dealId      String
  title       String
  description String?
  status      String    @default("PENDING") // PENDING (Red), IN_PROGRESS (Yellow), COMPLETED (Green)
  assignedTo  String?   // Role string (e.g. TITLE) or specific User ID
  isRequired  Boolean   @default(true)
  deal        Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("TODO")
  workspaceId  String
  dueDate      DateTime?
  assignedToId String?
  leadId       String?
  dealId       String?
  triggerEmail Boolean   @default(false)
  triggerSMS   Boolean   @default(false)
  triggerCall  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id])
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String    @id @default(cuid())
  type        String    @default("NOTE")
  content     String
  metadata    String?
  workspaceId String
  userId      String?
  leadId      String?
  dealId      String?
  contactId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkflowSession {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("DRAFT")
  data        String
  workspaceId String
  userId      String?
  leadId      String?
  dealId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SearchAlert {
  id          String   @id @default(cuid())
  leadId      String
  criteria    String   // JSON string: { city, minPrice, maxPrice, beds, baths }
  type        String   // VIEW, SHOWING, OFFER
  frequency   String   // INSTANT, DAILY, WEEKLY
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Segment {
  id          String   @id @default(cuid())
  name        String
  description String?
  filters     String?  // JSON string
  workspaceId String
  isPinned    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       Lead[]   @relation("LeadSegments")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentWorkflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  trigger     String   // e.g. "NEW_LEAD", "STATUS_CHANGE", "MANUAL"
  actions     String   // JSON string
  isActive    Boolean  @default(true)
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentLog {
  id          String   @id @default(cuid())
  actionType  String   // SMS, EMAIL, STATUS_UPDATE, NOTE
  details     String
  leadId      String?
  userId      String?
  workspaceId String
  createdAt   DateTime @default(now())
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LandingPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subdomain   String?
  blocks      String   // JSON string of page sections
  ownerId     String?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
// ==========================================
// Phase 12 - Listing & MLS Integration
// ==========================================

model MyPlusLeadsIntegration {
  id          String   @id @default(cuid())
  email       String
  password    String
  lastID      String?
  isActive    Boolean  @default(true)
  lastSyncAt  DateTime?
  workspaceId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

model PropertyListing {
  id              String   @id @default(cuid())
  mlsNumber       String?  @unique
  address         String
  city            String?
  state           String?
  zip             String?
  price           Float?
  bedrooms        Int?
  bathroomsFull   Int?
  bathroomsHalf   Int?
  squareFeet      Int?
  yearBuilt       Int?
  propertyType    String?  // SingleFamily, Condo, MultiFamily
  status          String   @default("ACTIVE") // ACTIVE, PENDING, SOLD
  description     String?
  images          String?  // JSON Array of image URLs
  virtualTourUrl  String?
  agentId         String?  // Link back to a user if it's their listing
  workspaceId     String
  source          String   @default("MANUAL") // MANUAL, RESO, MYPLUS
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

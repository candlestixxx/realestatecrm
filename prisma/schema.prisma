generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(cuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  role          String            @default("AGENT")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  activities    Activity[]
  contacts      Contact[]
  deals         Deal[]
  leads         Lead[]
  assignedTasks Task[]            @relation("TaskAssignee")
  workflows     WorkflowSession[]
  workspaces    WorkspaceMember[]
  stakeholderIn DealStakeholder[]
  campaigns     Campaign[]
}

model Workspace {
  id             String            @id @default(cuid())
  name           String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  Activity       Activity[]
  contacts       Contact[]
  deals          Deal[]
  leads          Lead[]
  smartPlans     SmartPlan[]
  workflows      WorkflowSession[]
  members        WorkspaceMember[]
  segments       Segment[]
  agentWorkflows AgentWorkflow[]
  agentLogs      AgentLog[]
  landingPages   LandingPage[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("AGENT")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model Contact {
  id               String            @id @default(cuid())
  firstName        String
  lastName         String?
  email            String?
  phone            String?
  address          String?
  workspaceId      String
  userId           String?
  additionalPhones String? // JSON array of additional phones
  additionalEmails String? // JSON array of additional emails
  spouseName       String?
  spousePhone      String?
  spouseEmail      String?
  familyMembers    String? // JSON array of family members
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  Activity         Activity[]
  user             User?             @relation(fields: [userId], references: [id])
  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deals            Deal[]
  leads            Lead[]
  stakeholderIn    DealStakeholder[]
}

model Lead {
  id              String            @id @default(cuid())
  type            String            @default("BUYER") // BUYER, SELLER, CLOSED
  source          String?
  status          String            @default("NEW") // Expanded statuses handled in UI logic
  score           Int?              @default(0)
  workspaceId     String
  contactId       String
  userId          String?
  isAiAssisted    Boolean           @default(false)
  socialProfiles  String?
  publicRecords   String?
  lastEnrichedAt  DateTime?
  tags            String? // Comma-separated hashtags
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  smartPlanId     String?
  Activity        Activity[]
  smartPlan       SmartPlan?        @relation(fields: [smartPlanId], references: [id])
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact         Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id])
  WorkflowSession WorkflowSession[]
  tasks           Task[]
  searchAlerts    SearchAlert[]
  segments        Segment[]         @relation("LeadSegments")
  agentLogs       AgentLog[]
}

model SmartPlan {
  id          String    @id @default(cuid())
  name        String
  description String?
  steps       String? // JSON string of steps
  isActive    Boolean   @default(true)
  scope       String    @default("INDIVIDUAL") // COMPANY or INDIVIDUAL
  leadType    String    @default("Buyer")
  duration    Int       @default(0)
  autoApply   Boolean   @default(false)
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  leads       Lead[]
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Deal {
  id              String            @id @default(cuid())
  title           String
  value           Float?
  stage           String            @default("LEAD")
  workspaceId     String
  contactId       String
  userId          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  Activity        Activity[]
  user            User?             @relation(fields: [userId], references: [id])
  contact         Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  WorkflowSession WorkflowSession[]
  tasks           Task[]
  stakeholders    DealStakeholder[]
  requirements    DealRequirement[]
}

model DealStakeholder {
  id          String   @id @default(cuid())
  dealId      String
  contactId   String?
  userId      String?
  role        String // TITLE, LENDER, INSPECTOR, APPRAISER, CLIENT
  permissions String   @default("VIEW_STATUS") // UPLOAD_DOCS, VIEW_STATUS, FULL_ACCESS
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])
  contact     Contact? @relation(fields: [contactId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DealRequirement {
  id          String   @id @default(cuid())
  dealId      String
  title       String
  description String?
  status      String   @default("PENDING") // PENDING (Red), IN_PROGRESS (Yellow), COMPLETED (Green)
  assignedTo  String? // Role string (e.g. TITLE) or specific User ID
  isRequired  Boolean  @default(true)
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  status       String    @default("TODO")
  workspaceId  String
  dueDate      DateTime?
  assignedToId String?
  leadId       String?
  dealId       String?
  triggerEmail Boolean   @default(false)
  triggerSMS   Boolean   @default(false)
  triggerCall  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  assignedTo   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id])
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal         Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String    @id @default(cuid())
  type        String    @default("NOTE")
  content     String
  metadata    String?
  workspaceId String
  userId      String?
  leadId      String?
  dealId      String?
  contactId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contact     Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model WorkflowSession {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("DRAFT")
  data        String
  workspaceId String
  userId      String?
  leadId      String?
  dealId      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deal        Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SearchAlert {
  id        String   @id @default(cuid())
  leadId    String
  criteria  String // JSON string: { city, minPrice, maxPrice, beds, baths }
  type      String // VIEW, SHOWING, OFFER
  frequency String // INSTANT, DAILY, WEEKLY
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Segment {
  id          String    @id @default(cuid())
  name        String
  description String?
  filters     String? // JSON string
  workspaceId String
  isPinned    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  leads       Lead[]    @relation("LeadSegments")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentWorkflow {
  id          String    @id @default(cuid())
  name        String
  description String?
  trigger     String // e.g. "NEW_LEAD", "STATUS_CHANGE", "MANUAL"
  actions     String // JSON string
  isActive    Boolean   @default(true)
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentLog {
  id          String    @id @default(cuid())
  actionType  String // SMS, EMAIL, STATUS_UPDATE, NOTE
  details     String
  leadId      String?
  userId      String?
  workspaceId String
  createdAt   DateTime  @default(now())
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model LandingPage {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  subdomain   String?
  blocks      String // JSON string of page sections
  ownerId     String?
  workspaceId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// ─── ORGANIZATION & AI VOICE FORGE SCHEMAS ───────────────────────────────────
// These are extensions based on the VoiceForge requirement

model Organization {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  plan             String   @default("FREE")
  stripeCustomerId String?
  settings         String   @default("{}") // Json string
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  aiAgents           AiAgent[]
  campaigns          Campaign[]
  integrations       Integration[]
  phoneNumbers       PhoneNumber[]
  emailTemplates     EmailTemplate[]
  smsTemplates       SmsTemplate[]
  voicemailTemplates VoicemailTemplate[]
  callLogs           CallLog[]
}

model AiAgent {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  // Voice Configuration
  voiceProvider String @default("ELEVENLABS")
  voiceId       String
  voiceName     String
  voiceGender   String
  voiceAccent   String @default("american")
  voiceAge      String @default("adult")
  voiceTone     String @default("professional")
  voiceSpeed    Float  @default(1.0)
  voicePitch    Float  @default(1.0)

  // Personality & Behavior
  personality         String @default("{}") // Json string
  systemPrompt        String
  objectionHandling   String @default("[]") // Json string
  qualifyingQuestions String @default("[]") // Json string

  // Transfer Settings
  transferThreshold Float  @default(0.7)
  transferGreeting  String @default("Let me connect you with a specialist who can help further.")

  // Voicemail
  voicemailScript      String?
  maxVoicemailDuration Int     @default(30)

  // Learning
  learningData        String @default("{}") // Json string
  totalCallsHandled   Int    @default(0)
  successfulTransfers Int    @default(0)
  avgSentimentScore   Float  @default(0)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
  callLogs  CallLog[]
}

model Campaign {
  id             String       @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  aiAgentId      String?
  aiAgent        AiAgent?     @relation(fields: [aiAgentId], references: [id])
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id])

  status String @default("DRAFT")
  type   String @default("OUTBOUND_CALLING")

  // Schedule
  startDate  DateTime?
  endDate    DateTime?
  startTime  String? // "09:00"
  endTime    String? // "17:00"
  timezone   String    @default("America/New_York")
  daysOfWeek String    @default("[1,2,3,4,5]") // Json array

  // Throttling
  callsPerMinute Int @default(5)
  callsPerHour   Int @default(50)
  callsPerDay    Int @default(200)
  maxConcurrent  Int @default(3)

  // Steps (the campaign sequence)
  steps CampaignStep[]

  // Stats
  totalLeads       Int @default(0)
  totalCalls       Int @default(0)
  totalConnected   Int @default(0)
  totalTransferred Int @default(0)
  totalConverted   Int @default(0)

  campaignLeads CampaignLead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CampaignStep {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  order      Int
  type       String
  templateId String? // references email/sms/voicemail template
  delayValue Int     @default(0) // e.g., 2
  delayUnit  String  @default("HOURS")

  // For call steps
  script      String?
  maxAttempts Int     @default(3)

  conditions String @default("[]") // Json string

  createdAt DateTime @default(now())
}

model CampaignLead {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  leadId     String

  status      String    @default("PENDING")
  currentStep Int       @default(0)
  attempts    Int       @default(0)
  lastAttempt DateTime?
  nextAttempt DateTime?
  outcome     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
}

model CallLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  leadId         String?
  aiAgentId      String?
  aiAgent        AiAgent?     @relation(fields: [aiAgentId], references: [id])

  // Call details
  twilioCallSid String? @unique
  direction     String
  fromNumber    String
  toNumber      String
  status        String

  // Timing
  startedAt    DateTime  @default(now())
  answeredAt   DateTime?
  endedAt      DateTime?
  duration     Int?      @default(0) // seconds
  ringDuration Int?      @default(0)

  // AI Analysis
  transcript    String?
  summary       String?
  sentiment     Float? // -1 to 1
  buyingSignals String  @default("[]") // Json string
  objections    String  @default("[]") // Json string
  outcome       String?

  // Transfer
  transferredTo String?
  transferredAt DateTime?

  // Recording
  recordingUrl      String?
  recordingSid      String?
  recordingDuration Int?

  // Voicemail
  voicemailLeft Boolean @default(false)
  voicemailUrl  String?

  // Metadata
  campaignId     String?
  campaignStepId String?
  cost           Float?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, startedAt])
  @@index([leadId])
  @@index([twilioCallSid])
}

model EmailTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  subject        String
  body           String
  variables      String       @default("[]") // json string
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model SmsTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  body           String
  variables      String       @default("[]") // json array
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model VoicemailTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  audioUrl       String?
  script         String?
  voiceId        String?
  duration       Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Integration {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           String
  name           String
  credentials    String // encrypted json
  settings       String       @default("{}") // json string
  isActive       Boolean      @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, type])
}

model PhoneNumber {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  phoneNumber    String       @unique
  friendlyName   String?
  twilioSid      String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
}

model ScheduledEvent {
  id          String   @id @default(cuid())
  leadId      String?
  type        String
  title       String
  description String?
  scheduledAt DateTime
  duration    Int? // minutes
  assignedTo  String?
  status      String   @default("SCHEDULED")
  metadata    String   @default("{}") // Json string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

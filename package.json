{
  "name": "real-estate-crm",
  "version": "0.54.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/kill-port.js 3000",
    "dev": "next dev -p 3000 --webpack",
    "build": "next build",
    "prestart": "node scripts/kill-port.js 3000",
    "start": "next start -p 3000",
    "lint": "eslint",
    "format": "prettier --write \".\"",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "sync:myplus": "tsx scripts/sync-myplusleads.ts",
    "kill:port": "node scripts/kill-port.js 3000",
    "dev:full": "node scripts/kill-port.js 3000 && next dev -p 3000 --webpack",
    "start:prod": "node scripts/kill-port.js 3000 && next build && next start -p 3000",
    "tray": "powershell -ExecutionPolicy Bypass -File scripts/system-tray.ps1"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/react": "^1.0.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/client-ses": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-libsql": "^6.14.0",
    "@prisma/client": "^6.14.0",
    "@radix-ui/react-tooltip": "^1.2.8",
    "ai": "^3.1.25",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "use-debounce": "^10.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "kill-port": "^2.0.1",
    "prettier": "^3.8.3",
    "prisma": "^6.14.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
